<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_back"/>

        <ImageView
            android:id="@+id/logoImage"
            android:layout_width="40dp"
            android:layout_height="68dp"
            android:layout_weight="1"
            android:src="@drawable/logo_emerald" />

        <ImageView
            android:id="@+id/notificationIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/notification" />
    </LinearLayout>
    
    <LinearLayout
        android:id="@+id/notification"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/headerLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp"
            app:layout_constraintBaseline_toBottomOf="@id/headerLayout">

            <TextView
                android:id="@+id/notificationlabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="140dp"
                android:text="Notifications"
                android:textSize="18dp"
                android:layout_marginStart="10dp"
                android:textColor="@color/emerald" />

            <TextView
                android:id="@+id/marksallasread"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mark all as read"
                android:textColor="@color/emerald"
                android:textSize="18dp"
                tools:ignore="TextSizeCheck" />
            </LinearLayout>
        
        <TextView
            android:id="@+id/notification1"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:text="notification about ..."
            android:textColor="@color/cream"
            android:textSize="20dp"
            android:background="@color/emerald"
            android:layout_marginBottom="10dp"/>
        <TextView
            android:id="@+id/notification2"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:text="notification about ..."
            android:textColor="@color/cream"
            android:textSize="20dp"
            android:background="@color/emerald"
            android:layout_marginBottom="10dp"/>
        <TextView
            android:id="@+id/notification3"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:text="notification about ..."
            android:textColor="@color/cream"
            android:textSize="20dp"
            android:background="@color/emerald"
            android:layout_marginBottom="10dp"/>
        <TextView
            android:id="@+id/notification4"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:text="notification about ..."
            android:textColor="@color/cream"
            android:textSize="20dp"
            android:background="@color/emerald"
            android:layout_marginBottom="10dp"/>
        <TextView
            android:id="@+id/notification5"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:text="notification about ..."
            android:textColor="@color/cream"
            android:textSize="20dp"
            android:background="@color/emerald"
            android:layout_marginBottom="10dp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomNavigationLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/emerald"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/homeIcon"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_weight="1"
            android:src="@drawable/ic_home_white" />

        <ImageView
            android:id="@+id/favoritesIcon"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_weight="1"
            android:src="@drawable/ic_favorite_white" />

        <ImageView
            android:id="@+id/cartIcon"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_weight="1"
            android:src="@drawable/ic_cart_white" />

        <ImageView
            android:id="@+id/profileIcon"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_weight="1"
            android:src="@drawable/ic_profile_white" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>