<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/emerald"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_back_white"/>

        <ImageView
            android:id="@+id/logoImage"
            android:layout_width="80dp"
            android:layout_height="68dp"
            android:layout_weight="1"
            android:src="@drawable/logo_white" />

        <ImageView
            android:id="@+id/notificationIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/notification_white" />
    </LinearLayout>
    
    <LinearLayout
        android:id="@+id/notification"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/headerLayout">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintBaseline_toBottomOf="@id/headerLayout">

            <TextView
                android:id="@+id/notificationlabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="200dp"
                android:text="Notifications"
                android:layout_marginStart="10dp"
                android:textColor="@color/cream" />

            <TextView
                android:id="@+id/marksallasread"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mark all as read"
                android:textColor="@color/cream"/>
            </LinearLayout>
        
        <TextView
            android:id="@+id/notification1"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:background="@color/light_green"
            android:layout_marginBottom="10dp"/>
        <TextView
            android:id="@+id/notification2"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:background="@color/light_green"
            android:layout_marginBottom="10dp"/>
        <TextView
            android:id="@+id/notification3"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:background="@color/light_green"
            android:layout_marginBottom="10dp"/>
        <TextView
            android:id="@+id/notification4"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:background="@color/light_green"
            android:layout_marginBottom="10dp"/>
        <TextView
            android:id="@+id/notification5"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:background="@color/light_green"
            android:layout_marginBottom="10dp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>